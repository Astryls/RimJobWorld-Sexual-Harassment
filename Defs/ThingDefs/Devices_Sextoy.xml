<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Sextoy Decoration "free to use" textures turned into lockable RJW bondage gear. Inheriting
       BondageGearBase gives each the HoloCrypto lock comp + Bondage category, so LockableGear() auto-enrolls
       them into the devious-device pool and BdsmGearCount counts them toward vulnerability. No wornGraphicPath:
       the source art is a single item icon (no directional pawn sprites), so the device is invisible when worn
       but still locks, gives the bound moodlet, and raises vulnerability. Worn art is a future task. -->

  <rjw.bondage_gear_def Name="RJWSH_DeviceBase" ParentName="BondageGearBase" Abstract="True">
    <soul_type>rjw.bondage_gear_soul</soul_type>
    <gives_bound_moodlet>true</gives_bound_moodlet>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <Beauty>-4</Beauty>
      <MarketValue>90</MarketValue>
      <Mass>0.2</Mass>
    </statBases>
  </rjw.bondage_gear_def>

  <!-- Slot bases: distinct body parts / layers so the devices mostly stack (crotch toys are mutually exclusive). -->
  <rjw.bondage_gear_def Name="RJWSH_GagBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel>
      <bodyPartGroups><li>Teeth</li></bodyPartGroups>
      <layers><li>Overhead</li></layers>
      <wornGraphicPath>Pawn/Humanlike/Apparel/RJWSH_GagWorn/RJWSH_GagWorn</wornGraphicPath>
    </apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_BlindfoldBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel>
      <bodyPartGroups><li>Eyes</li></bodyPartGroups>
      <layers><li>Overhead</li></layers>
      <wornGraphicPath>Pawn/Humanlike/Apparel/RJWSH_BlindfoldWorn/RJWSH_BlindfoldWorn</wornGraphicPath>
    </apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_TorsoDeviceBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel><bodyPartGroups><li>Torso</li></bodyPartGroups><layers><li>OnSkin</li></layers></apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_CuffsBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel><bodyPartGroups><li>Hands</li></bodyPartGroups><layers><li>Middle</li></layers></apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_CrotchDeviceBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel><bodyPartGroups><li>Waist</li></bodyPartGroups><layers><li>Belt</li></layers></apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_RopeBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel><bodyPartGroups><li>Torso</li><li>Legs</li></bodyPartGroups><layers><li>Shell</li></layers></apparel>
  </rjw.bondage_gear_def>
  <rjw.bondage_gear_def Name="RJWSH_NeckDeviceBase" ParentName="RJWSH_DeviceBase" Abstract="True">
    <apparel><bodyPartGroups><li>Neck</li></bodyPartGroups><layers><li>Middle</li></layers></apparel>
  </rjw.bondage_gear_def>

