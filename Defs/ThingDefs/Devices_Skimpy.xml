<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Lockable bondage-gear copies of "Skimpy Clothes for Nal's" apparel. Textures copied into
       Textures/RJWSH_src/Skimpy/. Inheriting BondageGearBase auto-locks them (HoloCrypto), gives the bound
       moodlet, and auto-enrolls them into the devious-device pool + vulnerability. Real directional worn art. -->

  <rjw.bondage_gear_def Name="RJWSH_SkimpyBase" ParentName="BondageGearBase" Abstract="True">
    <soul_type>rjw.bondage_gear_soul</soul_type>
    <gives_bound_moodlet>true</gives_bound_moodlet>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <Beauty>-2</Beauty>
      <MarketValue>120</MarketValue>
      <Mass>0.2</Mass>
    </statBases>
  </rjw.bondage_gear_def>

