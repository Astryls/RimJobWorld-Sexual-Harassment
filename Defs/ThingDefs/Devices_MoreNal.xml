<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Lockable bondage-gear copies of "More Nal Clothes" apparel. Textures copied into
       Textures/RJWSH_src/MoreNal/. All use a worn graphic mask (CutoutComplex). Inheriting BondageGearBase
       auto-locks them + enrolls them into the devious-device pool + vulnerability. -->

  <rjw.bondage_gear_def Name="RJWSH_MoreNalBase" ParentName="BondageGearBase" Abstract="True">
    <soul_type>rjw.bondage_gear_soul</soul_type>
    <gives_bound_moodlet>true</gives_bound_moodlet>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.6</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
      <Beauty>-2</Beauty>
      <MarketValue>120</MarketValue>
      <Mass>0.15</Mass>
    </statBases>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
    </apparel>
  </rjw.bondage_gear_def>

  <rjw.bondage_gear_def ParentName="RJWSH_MoreNalBase"><defName>RJWSH_DZZBSW</defName><label>white stockings</label><description>A locked pair of white silk stockings.</description>
    <graphicData><texPath>RJWSH_src/MoreNal/Apparel/DZZBSW/DZZBSW</texPath><graphicClass>Graphic_Single</graphicClass><shaderType>CutoutComplex</shaderType></graphicData>
    <apparel><bodyPartGroups><li>Feet</li></bodyPartGroups><layers><li>OnSkin</li></layers><wornGraphicPath>RJWSH_src/MoreNal/Apparel/DZZBSW/DZZBSW</wornGraphicPath></apparel></rjw.bondage_gear_def>
