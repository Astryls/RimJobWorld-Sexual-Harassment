<?xml version="1.0" encoding="utf-8" ?>
<!--
  [NL] Facial Animation faces for RJW Sexual Harassment. This whole folder only loads when
  Nals.FacialAnimation is active (About/LoadFolders.xml), because these defs reference FA's
  FaceAnimationDef type and its shape defs.

  PERSISTENT (thought-targeted, ConstantJob): FA keeps this face on the pawn the entire time they
  carry the matching moodlet - nervous when harassed, afraid when exposed, hollow when beaten-and-low,
  devoted when rewarded. No per-tick C# needed.
  ONE-SHOT (played from C# via FABridge.PlayTemporaryAnimation): brief spikes on grope/discipline/
  shock/reward, referenced by name (RJWSH_FA_Flinch / _Cry / _Bliss).

  CHANNEL RULE (learned the hard way - see below). A PERSISTENT thought-gated face may only claim
  headShapeDef and browShapeDef. It must NEVER claim mouthShapeDef or lidShapeDef, because those two
  channels are owned by FA's always-on Constant animation (blinking = 4 lid frames, breathing = 1 mouth
  frame) and by its per-job animations. Every FaceAnimationDef FA itself ships obeys this: Thoughts.xml
  claims head+brow only, while mouth/lid appear exclusively in Constant.xml and ForJobs/*.xml.

  Why breaking it is so visible: AnimationFrameAccumulator resolves each channel with
  `accumFrames.Where(x => x.mouthShapeDef != null).LastOrDefault()`, i.e. LAST WRITER WINS, recomputed
  every single tick. A persistent face that pins mouth=open therefore fights Constant's mouth frame for
  the channel, and the winner alternates as the accumulation order shifts - which renders as the pawn's
  mouth flapping open and shut forever. Same trap applies to lidShapeDef vs the blink cycle.
  (RJWSH_FA_Afraid shipped with mouth=open and RJWSH_FA_Hollow with lid=close; both are fixed below.)

  Practical palette for a persistent face is therefore headShapeDef (normal|blush) x browShapeDef
  (angled|flat|normal|s-shaped). The four faces below are differentiated purely on those two channels.
  ONE-SHOTS are exempt: they go into forcedTemporaryAnimationList, which the accumulator drains with
  RemoveAll(IsFinished) rather than looping, so they may claim mouth/lid for their short duration exactly
  as a job animation does.
  raceName is left default ("") so it applies to humanlikes, like Thought_Naked.
-->
<Defs>

  <!-- ============ PERSISTENT (thought-targeted) faces ============ -->

  <!-- Freshly harassed / groped: flushed cheeks + worried brow. Reads as distress, or as flustered
       arousal for a masochist (whose moodlet flipped positive) - deliberately ambiguous. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Nervous</defName>
    <priority>210</priority>
    <targetThoughtDefs>
      <li>RJWSH_WasHarassedMood</li>
      <li>RJWSH_WasGropedMood</li>
    </targetThoughtDefs>
    <animationFrames>
      <li>
        <duration>1</duration>
        <headShapeDef>blush</headShapeDef>
        <browShapeDef>s-shaped</browShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- Kept naked / bound / humiliated: flush + sharply angled brow = exposed, alarmed. Reads as a harder,
       more startled distress than Nervous's s-shaped worry, which is what separates the two now that the
       mouth channel is off limits (it used to add mouth=open, which caused the flapping - see header). -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Afraid</defName>
    <priority>215</priority>
    <targetThoughtDefs>
      <li>RJWSH_KeptNaked</li>
      <li>RJWSH_BoundExposed</li>
      <li>RJWSH_Humiliated</li>
    </targetThoughtDefs>
    <animationFrames>
      <li>
        <duration>1</duration>
        <headShapeDef>blush</headShapeDef>
        <browShapeDef>angled</browShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- Disciplined/shocked AND low mood: hollow and deadened. Gated low-mood so a content masochist does
       not get the broken look. No blush - pale and empty - and a FLAT brow, which reads as affectless far
       better than the forced-shut eyes this used to use (lid=close fought FA's blink cycle for the lid
       channel and made the eyes flicker - the same bug as the mouth flapping; see header). -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Hollow</defName>
    <priority>225</priority>
    <targetMoodMin>0</targetMoodMin>
    <targetMoodMax>0.35</targetMoodMax>
    <targetThoughtDefs>
      <li>RJWSH_Disciplined</li>
      <li>RJWSH_Shocked</li>
    </targetThoughtDefs>
    <animationFrames>
      <li>
        <duration>1</duration>
        <headShapeDef>normal</headShapeDef>
        <browShapeDef>flat</browShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- Tender moment / rewarded: soft, content, flushed - the devoted look. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Devoted</defName>
    <priority>205</priority>
    <targetThoughtDefs>
      <li>RJWSH_TenderMoment</li>
      <li>RJWSH_Rewarded</li>
    </targetThoughtDefs>
    <animationFrames>
      <li>
        <duration>1</duration>
        <headShapeDef>blush</headShapeDef>
        <browShapeDef>normal</browShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- ============ ONE-SHOT temporary faces (played from C#) ============
       These are ONLY ever played via FABridge.PlayTemporaryAnimation, which adds them straight to
       FA's forcedTemporaryAnimationList (bypassing the job/thought dict). They MUST NOT enter the
       ambient rotation: FaceAnimationDef defaults targetJobs to ["ConstantJob"], and any ConstantJob
       def with no targetThoughtDefs is applied to EVERY pawn every tick - which pinned every FA
       colonist's face into a permanent flinch/cry/bliss. Declaring a sentinel targetJobs that is
       neither "ConstantJob" nor any real JobDef defName removes them from all ambient lists while
       leaving PlayTemporaryAnimation fully functional. -->

  <!-- Sharp flinch: angled brow + open mouth. ~2s. Grope, shock, recoil. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Flinch</defName>
    <priority>400</priority>
    <targetJobs><li>RJWSH_NeverAmbient</li></targetJobs>
    <animationFrames>
      <li>
        <duration>120</duration>
        <browShapeDef>angled</browShapeDef>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- Fearful cringe: worried brow, squeezed-shut eyes, open mouth. ~3s. Discipline blow. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Cry</defName>
    <priority>400</priority>
    <targetJobs><li>RJWSH_NeverAmbient</li></targetJobs>
    <animationFrames>
      <li>
        <duration>180</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <lidShapeDef>close</lidShapeDef>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

  <!-- Flush of pleasure/relief: blush + half-lidded + soft brow. ~3s. Reward, affection. -->
  <FacialAnimation.FaceAnimationDef>
    <defName>RJWSH_FA_Bliss</defName>
    <priority>400</priority>
    <targetJobs><li>RJWSH_NeverAmbient</li></targetJobs>
    <animationFrames>
      <li>
        <duration>200</duration>
        <headShapeDef>blush</headShapeDef>
        <browShapeDef>s-shaped</browShapeDef>
        <lidShapeDef>close</lidShapeDef>
      </li>
    </animationFrames>
  </FacialAnimation.FaceAnimationDef>

</Defs>
